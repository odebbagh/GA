{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"events": [
		"onLoad",
		"onClick"
	],
	"windowTitle": "WIP report",
	"destination": "detailScreen",
	"width": 440,
	"height": 230,
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"Rectangle5": {
					"type": "rectangle",
					"top": 7,
					"left": 0,
					"width": 440,
					"height": 32,
					"fill": "#00A4A4",
					"stroke": "transparent",
					"sizingX": "grow"
				},
				"Text": {
					"type": "text",
					"text": "WIP report to Excel",
					"top": 15,
					"left": 8,
					"width": 300,
					"height": 16,
					"fontWeight": "bold"
				},
				"Text1": {
					"type": "text",
					"text": "Every active lot with work under way. Filters:",
					"top": 50,
					"left": 23,
					"width": 395,
					"height": 16
				},
				"Text2": {
					"type": "text",
					"text": "Customer",
					"top": 82,
					"left": 23,
					"width": 100,
					"height": 16
				},
				"dd_customer": {
					"type": "dropdown",
					"left": 129,
					"top": 79,
					"width": 289,
					"height": 23,
					"events": [
						"onDataChange"
					],
					"dataSource": "Form:C1466.customers"
				},
				"Text3": {
					"type": "text",
					"text": "Lot type",
					"top": 115,
					"left": 23,
					"width": 100,
					"height": 16
				},
				"dd_lotType": {
					"type": "dropdown",
					"left": 129,
					"top": 112,
					"width": 289,
					"height": 23,
					"events": [
						"onDataChange"
					],
					"dataSource": "Form:C1466.lotTypes"
				},
				"chk_onHoldOnly": {
					"type": "checkbox",
					"text": "On hold only",
					"top": 147,
					"left": 129,
					"width": 140,
					"height": 18,
					"dataSourceTypeHint": "boolean",
					"dataSource": "Form:C1466.onHoldOnly",
					"events": [
						"onClick"
					]
				},
				"chk_lateOnly": {
					"type": "checkbox",
					"text": "Late only",
					"top": 147,
					"left": 278,
					"width": 140,
					"height": 18,
					"dataSourceTypeHint": "boolean",
					"dataSource": "Form:C1466.lateOnly",
					"events": [
						"onClick"
					]
				},
				"Button": {
					"type": "button",
					"top": 195,
					"left": 268,
					"width": 70,
					"height": 20,
					"dataSource": "Button",
					"action": "cancel",
					"shortcutKey": "[Esc]",
					"text": "Cancel",
					"events": [
						"onClick"
					]
				},
				"Button1": {
					"type": "button",
					"top": 195,
					"left": 348,
					"width": 70,
					"height": 20,
					"dataSource": "Button",
					"action": "accept",
					"shortcutKey": "[Enter]",
					"text": "Export",
					"defaultButton": true,
					"events": [
						"onClick"
					]
				}
			}
		}
	],
	"geometryStamp": 1,
