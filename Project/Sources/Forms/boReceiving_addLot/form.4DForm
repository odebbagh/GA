					"left": 118,
					"width": 326,
					"height": 16,
					"dataSource": "Form:C1466.vendorLabel",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false,
					"fill": "transparent",
					"borderStyle": "none"
				},
				"lbl_lotNumber": {
					"type": "text",
