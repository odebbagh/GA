{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 0,
	"bottomMargin": 0,
	"events": [
		"onLoad",
		"onValidate"
	],
	"windowTitle": "Add Received Lot",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"header_title": {
					"type": "rectangle",
					"top": 0,
					"left": 0,
					"width": 460,
					"height": 34,
					"sizingX": "fixed",
					"fill": "#A2C6D8",
					"stroke": "transparent"
				},
				"lbl_title": {
					"type": "text",
					"text": "Add Received Lot",
