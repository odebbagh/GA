					"left": 16,
					"width": 420,
					"height": 18,
					"fontSize": 13,
					"fontWeight": "bold"
				},
				"lbl_part": {
					"type": "text",
					"text": "Part",
					"top": 52,
					"left": 16,
					"width": 90,
					"height": 16,
					"stroke": "#808080",
					"textAlign": "right"
				},
				"val_part": {
					"type": "input",
