{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 5,
	"bottomMargin": 0,
	"events": [
		"onLoad"
	],
	"windowTitle": "Jobs",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"lb_items": {
					"type": "listbox",
					"left": 0,
					"top": 44,
					"width": 420,
					"height": 216,
					"events": [
						"onDoubleClick"
					],
					"showHeaders": true,
					"selectionMode": "single",
					"listboxType": "collection",
					"dataSource": "Form:C1466.lb_items",
					"currentItemSource": "Form:C1466.item",
					"focusable": false,
					"scrollbarVertical": "automatic",
					"scrollbarHorizontal": "hidden",
					"method": "ObjectMethods/lb_items.4dm",
					"alternateFill": "#F1F1F1",
					"borderStyle": "none",
					"hideExtraBlankRows": false,
					"horizontalLineStroke": "transparent",
					"verticalLineStroke": "transparent",
					"columns": [
						{
							"header": {
								"name": "Header_jobNumber",
								"text": "Job #"
							},
							"name": "Column_jobNumber",
							"dataSource": "This:C1470.jobNumber",
							"width": 80,
							"footer": {
								"name": "Footer_jobNumber"
							}
						},
						{
							"header": {
								"name": "Header_customer",
								"text": "Customer"
							},
							"name": "Column_customer",
							"dataSource": "This:C1470.customer.name",
							"width": 240,
							"footer": {
								"name": "Footer_customer"
							}
						},
						{
							"header": {
								"name": "Header_created",
								"text": "Created"
							},
							"name": "Column_created",
							"dataSource": "This:C1470.dateCreated",
							"dataSourceTypeHint": "date",
							"width": 100,
							"footer": {
								"name": "Footer_created"
							}
						}
					]
				},
				"searchbox_roundRectangle1": {
					"type": "rectangle",
					"top": 8,
					"left": 5,
					"width": 415,
					"height": 27,
					"sizingX": "move",
					"stroke": "#008B8B",
					"borderRadius": 16,
					"fill": "#EDEDED",
					"strokeWidth": 3
				},
				"Image7": {
					"type": "picture",
					"top": 13,
					"left": 19,
					"width": 16,
					"height": 16,
					"sizingX": "move",
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/image/logo/loupe.png"
				},
				"word1": {
					"type": "input",
					"top": 13,
					"left": 42,
					"width": 350,
					"height": 16,
					"sizingX": "move",
					"dataSource": "Form:C1466.words",
					"fill": "transparent",
					"borderStyle": "none",
					"hideFocusRing": true,
					"placeholder": "job # or customer...",
					"dragging": "none",
					"dropping": "custom",
					"method": "ObjectMethods/word1.4dm",
					"events": [
						"onDataChange",
						"onAfterEdit"
					]
				},
				"searchbox_cross": {
					"type": "button",
					"top": 15,
					"left": 395,
					"width": 14,
					"height": 16,
					"sizingX": "move",
					"fontWeight": "bold",
					"stroke": "#008B8B",
					"focusable": false,
					"text": "X",
					"iconFrames": 4,
					"style": "custom",
					"method": "ObjectMethods/searchbox_cross.4dm",
					"events": [
						"onClick"
					]
				}
			}
		}
	],
	"geometryStamp": 78,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"method": "method.4dm"
}