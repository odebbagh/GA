{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 0,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onOutsideCall",
		"onDoubleClick",
		"onDrop",
		"onBeforeKeystroke",
		"onMenuSelect",
		"onPluginArea",
		"onDragOver",
		"onUnload",
		"onTimer",
		"onAfterKeystroke",
		"onAfterEdit",
		"onBeginDragOver",
		"onBoundVariableChange",
		"onPageChange"
	],
	"windowTitle": "Scan",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"bkgd_topBar": {
					"type": "rectangle",
					"top": 0,
					"left": 0,
					"width": 300,
					"height": 300,
					"sizingX": "fixed",
					"fill": "#FFFFFF",
					"stroke": "transparent",
					"sizingY": "fixed"
				},
				"image": {
					"type": "input",
					"left": 50,
					"top": 30,
					"width": 200,
					"height": 144,
					"dataSourceTypeHint": "picture",
					"enterable": false,
					"focusable": false,
					"contextMenu": "none",
					"fill": "transparent",
					"borderStyle": "none",
					"dataSource": "image",
					"pictureFormat": "scaled"
				},
				"bManualEntry": {
					"type": "button",
					"text": "ENTER CODE",
					"top": 260,
					"left": 15,
					"width": 130,
					"height": 40,
					"events": [
						"onClick"
					],
					"borderStyle": "none",
					"style": "regular",
					"action": "",
					"method": "ObjectMethods/bManualEntry.4dm",
					"stroke": "automatic",
					"textPlacement": "center",
					"defaultButton": false,
					"focusable": false
				},
				"bCancel": {
					"type": "button",
					"text": "CANCEL",
					"top": 260,
					"left": 155,
					"width": 130,
					"height": 40,
					"events": [
						"onClick"
					],
					"borderStyle": "none",
					"style": "regular",
					"action": "",
					"method": "ObjectMethods/bCancel.4dm",
					"stroke": "automatic",
					"textPlacement": "center",
					"defaultButton": false,
					"focusable": false
				},
				"Text": {
					"type": "text",
					"text": "Scan the barcode",
					"top": 195,
					"left": 25,
					"width": 250,
					"height": 45,
					"stroke": "#517AB3",
					"fontSize": 25,
					"textAlign": "center",
					"fontWeight": "normal"
				}
			},
			"entryOrder": [
				"bManualEntry",
				"bCancel",
				"image"
			]
