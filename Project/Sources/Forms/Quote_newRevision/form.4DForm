{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onClick",
		"onDataChange"
	],
	"windowTitle": "New revision",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"title": {
					"type": "input",
					"top": 16,
					"left": 20,
					"width": 480,
					"height": 20,
					"dataSource": "Form:C1466.title",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false,
					"fill": "transparent",
					"borderStyle": "none",
					"fontWeight": "bold",
					"fontSize": 14
				},
				"explanation": {
					"type": "input",
					"top": 44,
					"left": 20,
					"width": 480,
					"height": 50,
					"dataSource": "Form:C1466.explanation",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false,
					"fill": "transparent",
					"borderStyle": "none",
					"multiline": "yes",
					"scrollbarVertical": "hidden",
					"scrollbarHorizontal": "hidden"
				},
				"pup_levels": {
					"type": "dropdown",
					"top": 100,
					"left": 20,
					"width": 260,
					"height": 23,
					"dataSource": "Form:C1466.levels",
					"events": [
						"onDataChange"
					]
				},
				"label_note": {
					"type": "text",
					"text": "Note: why this revision (what changed, who asked)",
					"top": 136,
					"left": 20,
					"width": 480,
					"height": 16
				},
				"note": {
					"type": "input",
					"top": 156,
					"left": 20,
					"width": 480,
					"height": 100,
					"dataSource": "Form:C1466.note",
					"dataSourceTypeHint": "text",
					"multiline": "yes",
					"borderStyle": "system",
					"scrollbarVertical": "automatic",
					"scrollbarHorizontal": "hidden"
				},
				"bCancel": {
					"type": "button",
					"top": 270,
					"left": 300,
					"width": 90,
					"height": 22,
					"action": "cancel",
					"shortcutKey": "[Esc]",
					"text": "Cancel",
					"events": [
						"onClick"
					]
				},
				"bOK": {
					"type": "button",
					"top": 270,
					"left": 400,
					"width": 100,
					"height": 22,
					"action": "accept",
					"text": "New revision",
					"defaultButton": true,
					"events": [
						"onClick"
					]
				}
			}
		}
	],
	"geometryStamp": 1,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	}
}
