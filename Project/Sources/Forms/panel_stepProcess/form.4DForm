{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onActivate",
		"onDoubleClick",
		"onDrop",
		"onTimer",
		"onAfterKeystroke",
		"onBoundVariableChange",
		"onPageChange"
	],
	"windowTitle": "window title",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"label_name": {
					"type": "text",
					"top": 12,
					"left": 12,
					"width": 90,
					"height": 17,
					"stroke": "#808080",
					"text": "Name"
				},
				"entryField_name": {
					"type": "input",
					"top": 12,
					"left": 132,
					"width": 260,
					"height": 17,
					"dataSource": "Form:C1466.current_item.name",
					"focusable": true,
					"enterable": true,
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none",
					"textAlign": "left"
				},
				"label_standardHours": {
					"type": "text",
					"top": 36,
					"left": 12,
					"width": 115,
					"height": 17,
					"stroke": "#808080",
					"text": "Standard hours"
				},
				"entryField_standardHours": {
					"type": "input",
					"top": 36,
					"left": 132,
					"width": 80,
					"height": 17,
					"dataSource": "Form:C1466.current_item.standardHours",
					"method": "ObjectMethods/entryField_standardHours.4dm",
					"numberFormat": "###,##0.00",
					"focusable": true,
					"enterable": true,
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none",
					"textAlign": "right"
				},
				"label_standardHoursHint": {
					"type": "text",
					"top": 36,
					"left": 222,
					"width": 400,
					"height": 17,
					"stroke": "#808080",
					"fontStyle": "italic",
					"text": "fixed time per lot"
				},
				"label_secondsPerUnit": {
					"type": "text",
					"top": 60,
					"left": 12,
					"width": 115,
					"height": 17,
					"stroke": "#808080",
					"text": "Seconds per unit"
				},
				"entryField_secondsPerUnit": {
					"type": "input",
					"top": 60,
					"left": 132,
					"width": 80,
					"height": 17,
					"dataSource": "Form:C1466.current_item.secondsPerUnit",
					"method": "ObjectMethods/entryField_secondsPerUnit.4dm",
					"numberFormat": "###,##0.00",
					"focusable": true,
					"enterable": true,
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none",
					"textAlign": "right"
				},
				"label_secondsPerUnitHint": {
					"type": "text",
					"top": 60,
					"left": 222,
					"width": 600,
					"height": 17,
					"stroke": "#808080",
					"fontStyle": "italic",
					"text": "added for each unit of the lot: planned hours = standard hours + quantity x seconds / 3600"
				}
			}
		},
		{
			"objects": {
