{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowTitle": "Hold Lot",
	"destination": "detailScreen",
	"events": [
		"onLoad"
	],
	"pages": [
		{
			"objects": {
				"bk_color": {
					"type": "rectangle",
					"top": 0,
					"left": 0,
					"width": 560,
					"height": 290,
					"fill": "#E6E6E6",
					"stroke": "transparent"
				},
				"header": {
					"type": "rectangle",
					"top": 0,
					"left": 0,
					"width": 560,
					"height": 34,
					"fill": "#69A4C0",
					"stroke": "transparent"
				},
				"lab_title": {
					"type": "text",
					"top": 9,
					"left": 12,
					"width": 240,
					"height": 17,
					"text": "Hold Lot",
					"fontSize": 12,
					"fontWeight": "bold"
				},
				"lab_holdCode": {
					"type": "text",
					"top": 56,
					"left": 20,
					"width": 96,
					"height": 16,
					"textAlign": "right",
					"text": "Hold Code"
				},
				"inp_holdCode": {
					"type": "input",
					"top": 54,
					"left": 124,
					"width": 350,
					"height": 20,
					"dataSource": "Form:C1466.holdCodeDisplay",
					"enterable": false,
					"fill": "#FFFFFF",
					"borderStyle": "system"
				},
				"pup_holdCode": {
					"type": "button",
					"top": 54,
					"left": 482,
					"width": 28,
					"height": 20,
					"text": "...",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/pup_holdCode.4dm"
				},
				"lab_holdDate": {
					"type": "text",
					"top": 88,
					"left": 20,
					"width": 96,
					"height": 16,
					"textAlign": "right",
					"text": "Hold Date"
				},
				"inp_holdDate": {
					"type": "input",
					"top": 86,
					"left": 124,
					"width": 386,
					"height": 20,
					"dataSource": "Form:C1466.holdDateDisplay",
					"enterable": false,
					"fill": "#FFFFFF",
					"borderStyle": "system"
				},
				"lab_holdReason": {
					"type": "text",
					"top": 120,
					"left": 20,
					"width": 96,
					"height": 16,
					"textAlign": "right",
					"text": "Hold Reason"
				},
				"inp_holdReason": {
					"type": "input",
					"top": 118,
					"left": 124,
					"width": 386,
					"height": 120,
					"multiline": true,
					"dataSource": "Form:C1466.holdReason",
					"fill": "#FFFFFF",
					"borderStyle": "system"
				},
				"btn_cancel": {
					"type": "button",
					"top": 254,
					"left": 362,
					"width": 70,
					"height": 22,
					"action": "cancel",
					"text": "Cancel"
				},
				"btn_ok": {
					"type": "button",
					"top": 254,
					"left": 440,
					"width": 70,
					"height": 22,
					"action": "accept",
					"text": "OK"
				}
			}
		}
	],
	"method": "method.4dm"
}
